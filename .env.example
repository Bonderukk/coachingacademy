# Copy to .env and fill in. All are optional – without them the site falls back to e-mail.
# For the GitHub Pages build, set them as repository variables (Settings → Secrets and variables → Actions → Variables).

# Form backend for the book order, contact, and withdrawal forms: our PHP script server/form.php on the webhosting.
PUBLIC_FORM_ENDPOINT=https://coachacademy.sk/form.php

# Stripe Payment Link for the book (Stripe dashboard → Payment links → Create). Not used for now:
# without it the buy buttons open our order form (payment by bank transfer).
# Set the link's "After payment" redirect to https://coachingacademy.sk/kniha/dakujeme
PUBLIC_STRIPE_BOOK_LINK=
