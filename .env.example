# Copy to .env and fill in. Both are optional – without them the site falls back to e-mail.

# Stripe Payment Link for the book (Stripe dashboard → Payment links → Create).
# Set the link's "After payment" redirect to https://coachingacademy.sk/kniha/dakujeme
PUBLIC_STRIPE_BOOK_LINK=

# Form backend for the contact / signup / withdrawal forms, e.g. https://formspree.io/f/xxxxxxx
PUBLIC_FORM_ENDPOINT=
