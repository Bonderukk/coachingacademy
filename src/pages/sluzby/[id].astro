---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ContactForm from '../../components/ContactForm';
import { site } from '../../config/site';
import { breadcrumbs, service as serviceSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('sluzby');
  return services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const data = service.data;
const all = (await getCollection('sluzby')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((s) => s.id !== service.id).slice(0, 3);
---

<BaseLayout
  title={data.metaTitle}
  description={data.description}
  jsonLd={[serviceSchema(service), breadcrumbs([{ name: 'Služby', path: '/sluzby' }, { name: data.title, path: `/sluzby/${service.id}` }])]}
>
  <PageHero eyebrow={data.eyebrow} title={data.title} lead={data.summary} breadcrumbs={[{ label: 'Služby', href: '/sluzby' }, { label: data.title }]}>
    <a href="#formular" class="btn-primary mt-8">{data.cta}</a>
  </PageHero>

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_400px] lg:gap-16">
      <article class="prose prose-lg prose-ca max-w-none">
        <Content />
      </article>
      <div class="lg:sticky lg:top-28 lg:self-start">
        <Image
          src={data.image}
          alt={data.imageAlt}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 400px, 100vw"
          class="aspect-[4/5] w-full rounded-[2rem] object-cover"
        />
      </div>
    </div>
  </section>

  <section id="formular" class="section scroll-mt-20 bg-sand-100/60" aria-labelledby="formular-nadpis">
    <div class="container-page max-w-3xl">
      <p class="eyebrow">Otázka alebo objednávka</p>
      <h2 id="formular-nadpis" class="mt-3 text-4xl font-semibold">{data.cta}</h2>
      <p class="mt-3 text-lg text-muted">Napíšte nám pár slov o tom, čo riešite. Ozveme sa a dohodneme ďalší postup.</p>
      <div class="mt-10">
        <ContactForm client:visible endpoint={site.formEndpoint} email={site.email} topics={all.map((s) => s.data.title)} defaultTopic={data.title} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="dalsie-sluzby">
    <div class="container-page">
      <h2 id="dalsie-sluzby" class="text-3xl font-semibold md:text-4xl">Ďalšie služby</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>
</BaseLayout>
