---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseGrid from '../components/CourseGrid.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import BookPromo from '../components/BookPromo.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/people/dalibor-hero.jpg';
import badgeMcc from '../assets/badges/icf-mcc.png';
import badgeMcs from '../assets/badges/icf-mcs.png';
import badgeLevel1 from '../assets/badges/icf-level-1.png';
import badgeLevel2 from '../assets/badges/icf-level-2.png';
import badgePcic from '../assets/badges/pcic.png';
import iconJednotlivci from '../assets/icons/jednotlivci.png';
import iconKouci from '../assets/icons/kouci.png';
import iconFirmy from '../assets/icons/firmy.png';
import { site } from '../config/site';
import { organization } from '../lib/schema';

const courses = (await getCollection('vycviky')).sort((a, b) => a.data.order - b.data.order);
const testimonials = (await getCollection('referencie')).filter((t) => t.data.featured);

const badges = [
  { src: badgeMcc, alt: 'ICF Master Certified Coach (MCC)' },
  { src: badgeMcs, alt: 'ICF Mentor Coach Specialization (MCS), úroveň ACC' },
  { src: badgeLevel1, alt: 'ICF Level 1 – akreditované koučovacie vzdelávanie' },
  { src: badgeLevel2, alt: 'ICF Level 2 – akreditované koučovacie vzdelávanie' },
  { src: badgePcic, alt: 'PCIC – Professional Certified Integrative Coach' },
];

// `count` makes the number count up when it scrolls into view
const stats: { value: string; label: string; count?: number }[] = [
  { value: '2 500+', label: 'hodín individuálneho koučingu', count: 2500 },
  { value: '2011', label: 'odkedy vedieme koučovacie výcviky' },
  { value: 'ICF', label: 'akreditované výcviky od roku 2015' },
  { value: '100+', label: 'epizód podcastu o koučingu', count: 100 },
];

const audiences = [
  {
    icon: iconJednotlivci,
    title: 'Jednotlivci',
    text: 'Kvalitné, intenzívne a praktické sebarozvojové programy pre tých, ktorí chcú zmeniť svoj pracovný a súkromný život k lepšiemu.',
    href: '/sluzby/individualny-koucing',
    link: 'Individuálny koučing',
  },
  {
    icon: iconKouci,
    title: 'Kouči',
    text: 'Základné a nadstavbové programy pre koučov. Medzinárodne ICF certifikované programy s domácimi aj zahraničnými lektormi.',
    href: '/vycviky',
    link: 'Koučovacie výcviky',
  },
  {
    icon: iconFirmy,
    title: 'Firmy',
    text: 'Individuálne a skupinové rozvojové programy zamerané na koučing, mentoring a leadership – šité na mieru.',
    href: '/sluzby/timovy-koucing',
    link: 'Programy pre firmy',
  },
];

const jsonLd = [
  { '@context': 'https://schema.org', ...organization },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.fullName, url: site.url, inLanguage: 'sk' },
];
---

<BaseLayout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <!-- slowly drifting color blobs behind the hero -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute top-10 -right-24 size-[28rem] rounded-full bg-brand-200/50 blur-3xl motion-safe:animate-drift"></div>
      <div class="absolute -bottom-32 left-1/3 size-[24rem] rounded-full bg-sand-300/40 blur-3xl motion-safe:animate-drift motion-safe:[animation-delay:-9s]"></div>
    </div>

    <div class="container-page grid items-center gap-14 py-14 md:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-24">
      <div>
        <p class="eyebrow motion-safe:animate-fade-up">Koučingová akadémia Dalibora Bednaříka</p>
        <h1 class="mt-4 text-[2.6rem] leading-[1.05] font-semibold motion-safe:animate-fade-up motion-safe:[animation-delay:100ms] sm:text-6xl lg:text-[4.25rem]">
          Váš lokálny partner pre koučing <em class="font-medium text-brand-800">svetovej úrovne</em>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted motion-safe:animate-fade-up motion-safe:[animation-delay:200ms] md:text-xl">
          Medzinárodne ICF akreditované koučovacie výcviky, individuálny a tímový koučing v Bratislave. Vedie psychológ a MCC
          kouč Dalibor Bednařík.
        </p>
        <div class="mt-9 flex flex-col gap-3 motion-safe:animate-fade-up motion-safe:[animation-delay:300ms] sm:flex-row sm:flex-wrap">
          <a href={url('/vycviky')} class="btn-primary shine">Koučovacie výcviky</a>
          <a href={url('/sluzby/individualny-koucing')} class="btn-secondary">
            Individuálny koučing
            <Icon name="arrow-right" class="size-4 motion-safe:animate-nudge" />
          </a>
        </div>
        <!-- five equal columns at every width, so the row scales with the column and never wraps -->
        <ul class="mt-12 grid max-w-xl grid-cols-5 items-center gap-2 sm:gap-5" aria-label="Akreditácie a certifikácie">
          {
            badges.map((b, i) => (
              <li class="motion-safe:animate-fade-up" style={`animation-delay: ${450 + i * 90}ms`}>
                <Image
                  src={b.src}
                  alt={b.alt}
                  width={224}
                  height={224}
                  class="aspect-square w-full object-contain transition duration-300 motion-safe:hover:-translate-y-1 motion-safe:hover:-rotate-6"
                />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative mx-auto w-full max-w-md motion-safe:animate-fade-in motion-safe:[animation-delay:150ms] lg:max-w-none">
        <div class="absolute -inset-3 -z-10 rotate-3 rounded-[2.5rem] bg-sand-200/70"></div>
        <Image
          src={portrait}
          alt="Dalibor Bednařík, psychológ a profesionálny kouč ICF MCC"
          widths={[420, 720, 1000]}
          sizes="(min-width: 1024px) 38vw, (min-width: 448px) 448px, 100vw"
          priority
          class="aspect-[4/5] w-full rounded-[2rem] object-cover object-[50%_30%]"
        />
        <!-- MCC credential pinned to the photo; floats out of step with the "Kouč roka" card -->
        <Image
          src={badgeMcc}
          alt=""
          width={256}
          height={256}
          class="absolute -top-4 -right-2 size-24 object-contain drop-shadow-xl motion-safe:animate-float motion-safe:[animation-delay:-3s] sm:-top-6 sm:-right-6 sm:size-28 lg:size-32"
        />
        <div
          data-no-reveal
          class="card absolute -bottom-6 left-4 flex items-center gap-3 px-5 py-4 shadow-xl shadow-brand-950/10 motion-safe:animate-float sm:left-8"
        >
          <span class="flex size-11 items-center justify-center rounded-full bg-brand-900 font-serif text-white">19</span>
          <span class="leading-tight">
            <span class="block font-serif text-lg text-brand-950">Kouč roka 2019</span>
            <span class="block text-sm text-muted">Víťaz odbornej ankety</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-sand-200 bg-white" aria-label="Coaching Academy v číslach">
    <dl class="container-page grid grid-cols-2 gap-x-6 gap-y-8 py-10 md:grid-cols-4 md:py-12">
      {
        stats.map((s) => (
          <div class="flex flex-col gap-1">
            <dt class="text-[15px] text-muted">{s.label}</dt>
            <dd class="order-first font-serif text-4xl font-semibold text-brand-900 tabular-nums md:text-5xl" data-count={s.count} data-suffix={s.count && '+'}>
              {s.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Courses -->
  <section class="section" aria-labelledby="vycviky-nadpis">
    <div class="container-page">
      <div data-reveal class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">Ponuka výcvikov</p>
          <h2 id="vycviky-nadpis" class="mt-3 text-4xl font-semibold md:text-5xl">ICF koučovacie výcviky</h2>
          <p class="mt-4 text-lg text-muted">
            Od základov koučovacieho prístupu až po medzinárodnú certifikáciu ACC a PCC. Stupne na seba nadväzujú: CORE + 10
            mentoringov = LEVEL 1, LEVEL 1 + 5 dní = LEVEL 2.
          </p>
        </div>
        <a href={url('/vycviky')} class="btn-secondary self-start md:self-auto">Porovnať výcviky</a>
      </div>
      <CourseGrid courses={courses} class="mt-12" />
    </div>
  </section>

  <BookPromo />

  <!-- Audiences -->
  <section class="section bg-sand-100/60" aria-labelledby="pre-koho">
    <div class="container-page">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Naše služby</p>
        <h2 id="pre-koho" class="mt-3 text-4xl font-semibold md:text-5xl">S kým pracujeme</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          audiences.map((a, i) => (
            <article class="card group relative p-8 transition duration-300 hover:shadow-xl hover:shadow-brand-950/5 motion-safe:hover:-translate-y-1">
              <div class="w-fit motion-safe:animate-float" style={`animation-delay: -${i * 2}s`}><Image src={a.icon} alt="" width={144} height={144} class="size-18 object-contain" /></div>
              <h3 class="mt-6 text-2xl font-semibold">{a.title}</h3>
              <p class="mt-3 text-muted">{a.text}</p>
              <a href={url(a.href)} class="mt-6 inline-flex items-center gap-1.5 font-semibold text-brand-900 after:absolute after:inset-0">
                {a.link}
                <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section" aria-labelledby="referencie">
    <div class="container-page">
      <div data-reveal class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">Referencie</p>
          <h2 id="referencie" class="mt-3 text-4xl font-semibold md:text-5xl">Čo hovoria klienti a absolventi</h2>
        </div>
        <a href={url('/o-mne#referencie')} class="btn-secondary self-start md:self-auto">Všetky referencie</a>
      </div>
      <div class="mt-12 columns-1 gap-6 md:columns-2 lg:columns-3 [&>*]:mb-6">
        {testimonials.map((t) => <TestimonialCard testimonial={t} />)}
      </div>
    </div>
  </section>

  <!-- Podcast -->
  <section class="section pt-0" aria-labelledby="podcast">
    <div class="container-page">
      <div data-reveal class="grid gap-8 rounded-[2rem] bg-brand-950 p-8 text-brand-100 md:grid-cols-[1fr_auto] md:items-center md:p-12">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold tracking-[0.14em] text-brand-300 uppercase">Podcast · viac ako 100 epizód</p>
          <h2 id="podcast" class="mt-3 text-3xl font-semibold text-white md:text-4xl">O témach, ktoré sa ľudia často boja pomenovať nahlas</h2>
          <p class="mt-4 text-lg">
            Prežívanie, konflikty, vzťahy, osobný rast, tlak na výkon. Podcast pre osobnostný rast a vzdelávanie, plný princípu
            polarít.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
          <a href={url('/podcast')} class="btn-light"><Icon name="play" class="size-4" />Počúvať podcast</a>
          <a href={site.social.spotify} target="_blank" rel="noopener" class="btn-outline-light">
            <Icon name="spotify" class="size-4" />Otvoriť v Spotify
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
