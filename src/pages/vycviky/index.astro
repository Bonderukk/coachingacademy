---
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CourseCard from '../../components/CourseCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { breadcrumbs } from '../../lib/schema';

const courses = (await getCollection('vycviky')).sort((a, b) => a.data.order - b.data.order);

const path = [
  { step: 'CORE', title: 'Koučovací prístup', text: '5 × 2 dni výcviku, 88 hodín. Certifikát PCIC.', href: '/vycviky/business-life-coaching-core' },
  { step: 'LEVEL 1', title: 'Certifikácia ACC', text: 'CORE + 10 mentoringov a skúška. Príprava na ICF ACC.', href: '/vycviky/icf-level-1' },
  { step: 'LEVEL 2', title: 'Certifikácia PCC', text: 'LEVEL 1 + 5 dní a mentoringy. Príprava na ICF PCC.', href: '/vycviky/icf-level-2' },
];
---

<BaseLayout
  title="ICF koučovacie výcviky v Bratislave"
  description="Medzinárodne ICF akreditované koučovacie výcviky CORE, LEVEL 1 (ACC), LEVEL 2 (PCC) a systemický koučing v Bratislave. Vedie MCC kouč Dalibor Bednařík."
  jsonLd={breadcrumbs([{ name: 'Výcviky', path: '/vycviky' }])}
>
  <PageHero
    eyebrow="Koučovacie výcviky"
    title="ICF akreditované koučovacie výcviky"
    lead="Výcviky vedieme 2× ročne od roku 2011, medzinárodne akreditované International Coaching Federation od roku 2015. Prezenčne v Bratislave, v malých skupinách."
    breadcrumbs={[{ label: 'Výcviky' }]}
  />

  <section class="section" aria-labelledby="cesta">
    <div class="container-page">
      <h2 id="cesta" class="text-3xl font-semibold md:text-4xl">Cesta k medzinárodnej certifikácii</h2>
      <p class="mt-3 max-w-2xl text-lg text-muted">Stupne na seba nadväzujú – začať môžete výcvikom CORE a pokračovať podľa toho, kam chcete smerovať.</p>
      <ol class="mt-10 grid gap-4 md:grid-cols-3">
        {
          path.map((p, i) => (
            <li class="relative">
              <a href={url(p.href)} class="card block h-full p-7 transition-colors hover:border-brand-300">
                <span class="text-sm font-semibold text-brand-700">Krok {i + 1}</span>
                <p class="mt-2 font-serif text-3xl font-semibold text-brand-950">{p.step}</p>
                <p class="mt-1 font-medium">{p.title}</p>
                <p class="mt-3 text-[15px] text-muted">{p.text}</p>
              </a>
            </li>
          ))
        }
      </ol>

      <h2 class="mt-24 text-3xl font-semibold md:text-4xl">Všetky výcviky</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {courses.map((course) => <CourseCard course={course} />)}
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
