---
import { url } from '../lib/url';
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Nie ste si istí, ktorý program je pre vás ten pravý?',
  text = 'Napíšte alebo zavolajte – radi vám poradíme s výberom výcviku či služby.',
} = Astro.props;
---

<section class="section pt-0">
  <div class="container-page">
    <div data-reveal class="flex flex-col items-start gap-8 rounded-[2rem] border border-sand-200 bg-white p-8 md:flex-row md:items-center md:justify-between md:p-12">
      <div class="max-w-xl">
        <h2 class="text-3xl leading-tight font-semibold md:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-muted">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row md:flex-col lg:flex-row">
        <a href={url('/kontakt')} class="btn-primary">Napísať správu</a>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn-secondary">
          <Icon name="phone" class="size-4" />{site.phone}
        </a>
      </div>
    </div>
  </div>
</section>
