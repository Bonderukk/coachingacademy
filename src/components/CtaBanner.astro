---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import seal from '../assets/brand/seal-local-partner.png';
import { site } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Nie ste si istí, ktorý program je pre vás ten pravý?',
  text = 'Napíšte alebo zavolajte – radi vám poradíme s výberom výcviku či služby.',
} = Astro.props;
---

<section class="section pt-0">
  <div class="container-page">
    <div data-reveal class="flex flex-col gap-6 rounded-[2rem] border border-sand-200 bg-white p-8 md:flex-row md:items-center md:justify-between md:gap-12 md:p-12">
      <!-- "Your local partner" seal: above the heading on phones, on the right from tablets up -->
      <Image
        src={seal}
        alt="Your local partner for world class coaching quality"
        width={192}
        height={192}
        densities={[1, 2]}
        class="size-24 shrink-0 motion-safe:animate-float md:order-last md:size-40 lg:size-48"
      />
      <div class="max-w-2xl">
        <h2 class="text-3xl leading-tight font-semibold md:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-muted">{text}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href={url('/kontakt')} class="btn-primary">Napísať správu</a>
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn-secondary">
            <Icon name="phone" class="size-4" />{site.phone}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
