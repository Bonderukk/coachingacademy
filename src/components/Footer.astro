---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-horizontal-white.png';
import Icon from './Icon.astro';
import { nav, site } from '../config/site';

const [vycviky, sluzby] = nav;
const year = new Date().getFullYear();
const { company } = site;
const social = [
  { name: 'linkedin', href: site.social.linkedin, label: 'LinkedIn' },
  { name: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { name: 'youtube', href: site.social.youtube, label: 'YouTube' },
  { name: 'spotify', href: site.social.spotify, label: 'Podcast na Spotify' },
] as const;
---

<footer class="mt-auto bg-brand-950 text-brand-100/80">
  <div class="container-page grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div>
      <a href={url('/')} class="inline-block">
        <Image src={logo} alt="Dalibor Bednařík Coaching Academy" width={186} height={52} densities={[1, 2, 3]} class="h-13 w-auto" />
      </a>
      <p class="mt-5 max-w-xs text-[15px]">
        Koučingová akadémia od roku 2006. Medzinárodne ICF akreditované výcviky od roku 2015.
      </p>
      <ul class="mt-6 flex gap-2">
        {
          social.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="inline-flex size-10 items-center justify-center rounded-full bg-white/5 text-white transition-colors hover:bg-white/15"
              >
                <Icon name={s.name} class="size-[18px]" label={s.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label="Výcviky">
      <h2 class="font-sans text-sm font-semibold tracking-[0.14em] text-white uppercase">{vycviky.label}</h2>
      <ul class="mt-3 space-y-0.5 text-[15px]">
        {vycviky.children?.map((l) => <li><a href={url(l.href)} class="inline-block py-1 hover:text-white">{l.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Služby">
      <h2 class="font-sans text-sm font-semibold tracking-[0.14em] text-white uppercase">{sluzby.label}</h2>
      <ul class="mt-3 space-y-0.5 text-[15px]">
        {sluzby.children?.map((l) => <li><a href={url(l.href)} class="inline-block py-1 hover:text-white">{l.label}</a></li>)}
        <li><a href={url('/kniha')} class="inline-block py-1 hover:text-white">Kniha KOUČING</a></li>
        <li><a href={url('/podcast')} class="inline-block py-1 hover:text-white">Podcast</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="font-sans text-sm font-semibold tracking-[0.14em] text-white uppercase">Kontakt</h2>
      <ul class="mt-3 space-y-1 text-[15px]">
        <li>
          <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2.5 py-1 hover:text-white">
            <Icon name="mail" class="size-4" />{site.email}
          </a>
        </li>
        <li>
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-2.5 py-1 hover:text-white">
            <Icon name="phone" class="size-4" />{site.phone}
          </a>
        </li>
      </ul>
      <address class="mt-4 text-sm leading-relaxed not-italic text-brand-100/60">
        {company.name}<br />
        {company.street}, {company.zip} {company.city}<br />
        IČO: {company.ico}<br />
        {company.register}
      </address>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-sm text-brand-100/60 md:flex-row md:items-center md:justify-between">
      <p>© {year} {company.name}</p>
      <ul class="-my-1 flex flex-wrap gap-x-5">
        <li><a href={url('/gdpr')} class="inline-block py-1 hover:text-white">Ochrana osobných údajov</a></li>
        <li><a href={url('/vop')} class="inline-block py-1 hover:text-white">Obchodné podmienky</a></li>
        <li><a href={url('/zrusenie-objednavky')} class="inline-block py-1 hover:text-white">Odstúpiť od zmluvy</a></li>
      </ul>
    </div>
  </div>
</footer>
