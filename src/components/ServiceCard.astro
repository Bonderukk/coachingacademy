---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  service: CollectionEntry<'sluzby'>;
}

const { service } = Astro.props;
const { title, summary, image, imagePosition } = service.data;
---

<article class="card group relative flex flex-col overflow-hidden transition duration-300 hover:shadow-xl hover:shadow-brand-950/5 motion-safe:hover:-translate-y-1">
  <div class="aspect-[3/2] overflow-hidden bg-sand-100">
    <Image
      src={image}
      alt=""
      widths={[400, 700]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="size-full object-cover grayscale-[30%] transition duration-500 group-hover:scale-105 group-hover:grayscale-0"
      style={`object-position: ${imagePosition}`}
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl leading-snug font-semibold">
      <a href={url(`/sluzby/${service.id}`)} class="after:absolute after:inset-0">{title}</a>
    </h3>
    <p class="mt-3 flex-1 text-[15px] leading-relaxed text-muted">{summary}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-[15px] font-semibold text-brand-900">
      Zistiť viac <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</article>
