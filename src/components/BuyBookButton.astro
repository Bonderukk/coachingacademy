---
import { book, formatPrice, site } from '../config/site';

interface Props {
  variant?: 'primary' | 'light';
  class?: string;
}

const { variant = 'primary', class: className } = Astro.props;
const total = book.price + book.shipping;
const label = `${book.preorder ? 'Predobjednať' : 'Kúpiť'} knihu – ${formatPrice(total)}`;

// Until the Stripe Payment Link is configured, orders go by e-mail so the page is usable right away.
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(`Objednávka knihy ${book.shortTitle}`)}&body=${encodeURIComponent(
  'Dobrý deň,\n\nmám záujem o knihu KOUČING.\n\nPočet kusov: 1\nMeno a priezvisko:\nDoručovacia adresa:\nTelefón:\n\nĎakujem',
)}`;
const href = book.stripeLink || mailto;
---

<a href={href} class:list={[variant === 'light' ? 'btn-light' : 'btn-primary', 'px-7 py-3.5 text-base', className]}>
  {label}
</a>
