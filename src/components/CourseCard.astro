---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatPrice } from '../config/site';

interface Props {
  course: CollectionEntry<'vycviky'>;
  /** Position in the grid – offsets the idle animation so neighbouring cards don't move in sync. */
  index?: number;
}

const { course, index = 0 } = Astro.props;
const { title, eyebrow, summary, badge, image, priceFrom, startDate } = course.data;
const href = url(`/vycviky/${course.id}`);
const idleDelay = `animation-delay: -${index * 1.7}s`;
// Only upcoming runs get the "Štart" chip (evaluated at build time).
const upcoming = startDate && startDate > new Date() ? new Intl.DateTimeFormat('sk-SK').format(startDate) : undefined;
---

<article class="card group relative flex flex-col overflow-hidden transition duration-300 hover:shadow-xl hover:shadow-brand-950/5 motion-safe:hover:-translate-y-1">
  {
    upcoming && (
      <p class="pointer-events-none absolute top-4 left-4 z-10 inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-brand-900 shadow-sm backdrop-blur">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full rounded-full bg-brand-500/60 motion-safe:animate-ping" />
          <span class="relative inline-flex size-2 rounded-full bg-brand-600" />
        </span>
        Štart {upcoming}
      </p>
    )
  }
  {
    badge ? (
      <div class="flex items-center justify-center bg-sand-100 px-8 pt-12 pb-6">
        <div class="motion-safe:animate-float" style={idleDelay}>
          <Image src={badge} alt="" width={160} height={160} class="size-36 object-contain transition-transform duration-300 group-hover:scale-105" />
        </div>
      </div>
    ) : (
      image && (
        <div class="aspect-[16/10] overflow-hidden bg-sand-100">
          <Image
            src={image}
            alt=""
            widths={[400, 800]}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            class="size-full object-cover motion-safe:animate-kenburns"
            style={idleDelay}
          />
        </div>
      )
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-semibold tracking-[0.12em] text-brand-700 uppercase">{eyebrow.split('·')[0]}</p>
    <h3 class="mt-2 text-xl leading-snug font-semibold">
      <a href={href} class="after:absolute after:inset-0">{title}</a>
    </h3>
    <p class="mt-3 flex-1 text-[15px] leading-relaxed text-muted">{summary}</p>
    <div class="mt-5 flex items-center justify-between border-t border-sand-200 pt-4 text-[15px]">
      {priceFrom && <span class="text-muted">od <strong class="text-brand-950">{formatPrice(priceFrom)}</strong></span>}
      <span class="inline-flex items-center gap-1.5 font-semibold text-brand-900">
        Viac <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
      </span>
    </div>
  </div>
</article>
