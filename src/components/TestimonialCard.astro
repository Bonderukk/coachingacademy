---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  testimonial: CollectionEntry<'referencie'>;
}

const { name, role, quote, photo } = Astro.props.testimonial.data;
const initials = name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<figure class="card flex break-inside-avoid flex-col p-7">
  <Icon name="quote" class="size-7 text-brand-200" />
  <blockquote class="mt-4 flex-1 text-[16px] leading-relaxed text-ink">
    <p>„{quote}“</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3.5 border-t border-sand-200 pt-5">
    {
      photo ? (
        <Image src={photo} alt={`Fotografia: ${name}`} width={96} height={96} class="size-12 shrink-0 rounded-full object-cover" />
      ) : (
        <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-100 font-serif text-brand-900">{initials}</span>
      )
    }
    <span>
      <span class="block font-semibold text-brand-950">{name}</span>
      <span class="block text-sm text-muted">{role}</span>
    </span>
  </figcaption>
</figure>
