# Never serve the settings (database and SMTP passwords), even if PHP were ever switched off.
<FilesMatch "^(form-config.*\.php.*|\.ht.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
